# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual Environments
.venv/
venv/
ENV/
env/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
test_out.log
test_err.log

# Streamlit local secrets
.streamlit/secrets.toml

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Generated Model & Report Artifacts (keep folder structure)
artifacts/models/*
!artifacts/models/.gitkeep
artifacts/reports/*
!artifacts/reports/.gitkeep
